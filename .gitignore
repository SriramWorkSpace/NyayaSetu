# ── dependencies ──────────────────────────────
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# ── build output ──────────────────────────────
dist/
build/
app/src-tauri/target/
target/
app/src-tauri/backend-dist/
release-artifacts/

# ── vendored native binary, not source ────────
# A trimmed copy of a local Tesseract install (tesseract.exe + its DLLs +
# eng/osd tessdata only), copied in per decisions.md D-037 so the PyInstaller
# sidecar can bundle a working OCR binary without depending on Tesseract
# being separately installed on the machine that builds the installer.
# Regenerable from any local Tesseract install (CLAUDE.md's repeatable
# actions) - not committed, at 174MB, without being asked to push that onto
# the git-lfs quota on top of backend/artifacts' existing ~700MB.
backend/vendor/

# ── datasets: fetched, never committed ────────
ml/data/

# ── model artifacts ────────────────────────────
# backend/artifacts/** is git-lfs tracked via .gitattributes, not ignored -
# these extensions must stay trackable there. A blanket *.joblib-style
# ignore here previously made `git add` silently skip them even inside
# backend/artifacts/, defeating the LFS setup entirely (caught in Phase 6
# when trained model files never showed up in `git status`). Anything
# matching these extensions OUTSIDE backend/artifacts/ is still unwanted -
# scope the ignore to everywhere else instead of dropping it blanket.
/**/*.pt
/**/*.pth
/**/*.bin
/**/*.safetensors
/**/*.faiss
/**/*.index
/**/*.pkl
/**/*.joblib
!backend/artifacts/**

# ── derived knowledge graph ───────────────────
graphify-out/

# ── secrets ───────────────────────────────────
.env
.env.local
!.env.example

# ── scratch / OS / editor ─────────────────────
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Claude Code session artifacts - not project content
.claude/
