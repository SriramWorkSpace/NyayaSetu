{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NyayaSetu",
  "version": "0.1.0",
  "identifier": "in.nyayasetu.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "NyayaSetu",
        "width": 1280,
        "height": 832,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 1024,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
